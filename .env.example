# Copy to .env.local. Never commit real secrets.
# Docker Compose does not read .env.local by itself. Start it with:
#   docker compose --env-file .env.local up

# --- App ---
AUTH_URL=http://localhost:3000
AUTH_SECRET=

# --- MongoDB (runs on the host, not in Docker) ---
# Put the database in the URI, or omit it and set MONGODB_DATABASE.
# Default database name is training_platform.
MONGODB_URI=mongodb://localhost:27017/training_platform
MONGODB_DATABASE=

# --- Keycloak (Phase 2–3) ---
# Public issuer the browser uses. Realm name is `training`.
KEYCLOAK_ISSUER=http://localhost:8080/realms/training
# Base URL the Next.js server uses. localhost on the host; http://keycloak:8080 inside Compose.
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_CLIENT_ID=training-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_ID=training-admin-svc
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Passed only to the Keycloak container. The Next.js app does not read these.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=
# Optional. Defaults to database keycloak.
# KC_DB_URL_DATABASE=keycloak

# --- Video files (Phase 5) ---
# ./media on the host. Docker overrides this to /app/media.
MEDIA_DIR=./media
MAX_UPLOAD_MB=500
