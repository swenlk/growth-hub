# --- App ---
# Public origin of this app. Use https:// in production.
AUTH_URL=http://localhost:3000
AUTH_SECRET=

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/

# --- Keycloak ---
# Public issuer. Realm name is the path segment after /realms/.
KEYCLOAK_ISSUER=http://localhost:8080/realms/growth-hub
# Address the Next.js process uses to reach Keycloak.
# localhost on the host. Compose sets http://keycloak:8080 for the web container.
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_CLIENT_ID=growth-hub-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_ID=growth-hub-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# First Keycloak boot and npm run setup:keycloak. The Next.js app does not read these.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# MySQL database Keycloak uses. It must already exist.
KC_DB_URL_DATABASE=growth-hub
KC_DB_USERNAME=growth-hub
KC_DB_PASSWORD=change-me

# --- Video files ---
# ./media on the host. Compose overrides this to /app/media.
MEDIA_DIR=./media
