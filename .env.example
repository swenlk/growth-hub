# --- App ---
# Public origin of this app. Use https:// in production.
AUTH_URL=http://localhost:3002
AUTH_SECRET=

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/
# Registry database. Each organization also gets a database named <MONGODB_DATABASE>_<slug>.
# Set TENANT_DB_PREFIX only when that prefix should differ from <MONGODB_DATABASE>_.
MONGODB_DATABASE=growth_hub

# --- Keycloak ---
# Public issuer. Realm name is the path segment after /realms/.
KEYCLOAK_ISSUER=http://localhost:8080/realms/growth-hub
# Address the Next.js process uses to reach Keycloak.
# localhost on the host. Compose sets http://keycloak:8080 for the web container.
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_CLIENT_ID=growth-hub-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_ID=growth-hub-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# First Keycloak boot and npm run setup:keycloak. The Next.js app does not read these.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# MySQL database Keycloak uses. It must already exist.
KC_DB_URL_DATABASE=growth-hub
KC_DB_USERNAME=growth-hub
KC_DB_PASSWORD=change-me

# --- Video files ---
# ./media on the host. Compose overrides this to /app/media.
MEDIA_DIR=./media

# --- Microsoft Entra ID ---
# Optional. Leave blank until the app registration exists, then run npm run setup:keycloak.
# Email and password sign-in stays. Microsoft is an extra button on the Keycloak page.
# It signs in only when that email already belongs to a Growth Hub account.
# Entra redirect URI:
# http://localhost:8080/realms/growth-hub/broker/microsoft/endpoint
MICROSOFT_ENTRA_TENANT_ID=
MICROSOFT_ENTRA_CLIENT_ID=
MICROSOFT_ENTRA_CLIENT_SECRET=
